rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email in [
          "rjbcom4263@gmail.com"
        ];
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if false;

      // 실시간 공지 방송 (모니터 페이지가 로그인 없이 발송/조회)
      match /broadcast/{docId} {
        allow read: if true;
        allow write: if true;
      }

      // 행사 일정 (모니터 페이지가 로그인 없이 등록/수정/삭제)
      match /schedule/{itemId} {
        allow read: if true;
        allow write: if true;
      }

      match /participants/{uid} {
        allow get: if isOwner(uid) || isAdmin();
        allow list: if true;
        allow create, update: if false;
        allow delete: if false;

        match /stamps/{pointId} {
          allow get, list: if isOwner(uid) || isAdmin();
          allow create, update: if false;
          allow delete: if false;
        }
      }

      match /stampPoints/{pointId} {
        allow read: if true;
        allow write: if false;
      }

      match /rewards/{rewardId} {
        allow read, write: if false;
      }
    }

    match /systemCounters/{document=**} {
      allow read, write: if false;
    }

    match /idempotency/{document=**} {
      allow read, write: if false;
    }
  }
}
